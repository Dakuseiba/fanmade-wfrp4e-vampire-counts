<section class="tab cc-vampire-tab {{tab.cssClass}}" data-tab="vampire" data-group="primary"><fieldset><legend>Krew</legend><div class="form-group"><label>Vampire Rank</label><div class="form-fields"><select data-cc-rank>{{#each ccRanks}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></div></div><p>Blood Thirst: posiłek co {{ccFeeding.amount}} {{ccFeeding.unit}}. Czas rozliczany ręcznie.</p><div class="form-group"><label>Wypita krew</label><div class="form-fields"><input aria-label="blood" name="blood" type="number" min="1" value="3"><button data-act="feed">Pożyw się</button></div></div></fieldset><fieldset><legend>Światło dnia</legend><div class="form-group"><label>Czas ekspozycji (min)</label><div class="form-fields"><input aria-label="minutes" name="minutes" type="number" min="1" value="1"><label><input name="overcast" type="checkbox"> Zachmurzenie ≥80%</label></div></div><div class="cc-actions"><button data-act="sun">Ekspozycja</button>{{#if ccDawn}}<button data-act="dawn">Defy the Dawn</button>{{#if ccDawnProtected}}<button data-cc="end-dawn">Zakończ ochronę</button>{{/if}}{{/if}}</div><div class="form-group"><label>Pobyt w schronieniu (min)</label><div class="form-fields"><input name="shelterMinutes" type="number" min="0" value="10"><button data-act="shade">Rozlicz pobyt</button></div></div></fieldset>{{#if ccShowForms}}<fieldset><legend>Przemiany</legend>
{{#if ccForms.length}}<div class="form-group"><label>Postać</label><div class="form-fields"><select name="form">{{#each ccForms}}<option value="{{name}}">{{name}}</option>{{/each}}</select></div></div>{{/if}}
<div class="cc-actions">{{#unless ccTransformed}}{{#each ccSpiritForms}}<button data-cc-item="{{id}}">{{name}}</button>{{/each}}{{/unless}}{{#if ccForms.length}}{{#unless ccTransformed}}<button data-act="transform">Przemień się</button>{{/unless}}{{/if}}{{#if ccTransformed}}<button data-act="revert">Powróć</button>{{/if}}{{#if ccHuman}}<button data-act="human">Pass for Human — {{#if ccHumanActive}}zakończ{{else}}aktywuj{{/if}}</button>{{/if}}</div>
{{#if ccHuman}}<div class="form-group"><label>Pass for Human</label><div class="form-fields"><label><input type="checkbox" data-cc-human-token {{checked ccHumanTokenArt}}> Zmieniaj grafikę tokenu</label></div></div>{{/if}}
{{#if ccArtForms.length}}<details><summary>Wygląd form</summary>{{#each ccArtForms}}<fieldset class="cc-form-art" data-form="{{name}}"><legend>{{name}}</legend><div class="form-fields"><input type="text" data-art-path value="{{art}}" placeholder="Grafika tokenu — {{name}}" aria-label="Grafika: {{name}}"><button data-cc="browse-art" title="Wybierz grafikę"><i class="fas fa-folder-open"></i></button><button data-cc="save-art">Zapisz</button></div></fieldset>{{/each}}</details>{{/if}}
</fieldset>{{/if}}{{#if ccDarkFate}}<fieldset><legend>Dark Fate</legend><div class="cc-actions"><button data-act="darkFate">Wydaj Przeznaczenie</button><button data-act="darkFortune">Wydaj Szczęście</button><button data-act="darkRefresh">Nowa sesja</button></div></fieldset>{{/if}}<div class="sheet-list condensed"><div class="list-header row-content"><div class="list-name">Dary krwi</div></div><div class="list-content">{{#each ccGifts}}<div class="list-row" data-uuid="{{uuid}}"><div class="row-content"><div class="list-name"><a data-action="editEmbedded">{{name}}</a>{{#if suppressedBy}} <i class="fas fa-shield" data-tooltip="Neutralizuje: {{suppressedBy}}"></i>{{/if}}</div><div class="list-controls"><span class="cc-rank">{{level}}</span><button data-action="deleteEmbedded" title="Usuń: {{name}}" aria-label="Usuń: {{name}}"><i class="fas fa-trash"></i></button><button data-cc-item="{{id}}" title="Użyj: {{name}}" aria-label="Użyj: {{name}}"><i class="fas fa-dice-d10"></i></button></div></div></div>{{else}}<p class="cc-empty">—</p>{{/each}}</div></div><div class="sheet-list condensed"><div class="list-header row-content"><div class="list-name">Słabości</div></div><div class="list-content">{{#each ccWeaknesses}}<div class="list-row" data-uuid="{{uuid}}"><div class="row-content"><div class="list-name"><a data-action="editEmbedded">{{name}}</a>{{#if suppressedBy}} <i class="fas fa-shield" data-tooltip="Neutralizuje: {{suppressedBy}}"></i>{{/if}}</div><div class="list-controls"><span class="cc-rank">{{level}}</span><button data-action="deleteEmbedded" title="Usuń: {{name}}" aria-label="Usuń: {{name}}"><i class="fas fa-trash"></i></button><button data-cc-item="{{id}}" title="Użyj: {{name}}" aria-label="Użyj: {{name}}"><i class="fas fa-dice-d10"></i></button></div></div></div>{{else}}<p class="cc-empty">—</p>{{/each}}</div></div></section>